# Tùy chọn. run-local.sh đã tự đặt các đường dẫn local an toàn.
PORT=8000

# Có thể cấu hình provider bằng giao diện Settings, hoặc dùng env:
# NOVELKIT_LLM_BASE_URL=https://api.openai.com/v1
# NOVELKIT_LLM_MODEL=gpt-5
# NOVELKIT_LLM_API_KEY=your-api-key
# NOVELKIT_LLM_TEMPERATURE=0.7
# NOVELKIT_LLM_MAX_TOKENS=8192

# Chỉ cần đặt khi muốn đổi vị trí dữ liệu mặc định trong folder lite.
# NOVELKIT_DATABASE_URL=sqlite:////absolute/path/novelkit-lite.db
# NOVELKIT_STORAGE_ROOT=/absolute/path/storage
# NOVELKIT_WORKSPACE_ROOT=/absolute/path/workspaces
# NOVELKIT_SECRETS_DIR=/absolute/path/.secrets
